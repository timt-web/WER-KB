{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timt-web/WER-KB/schemas/resource_catalog.schema.json",
  "title": "WER-KB resource catalog",
  "description": "JSON form of data/resource_catalog.csv.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "resource_id",
      "resource_name",
      "resource_class",
      "analytical_function",
      "workflow_stages",
      "evidence_type",
      "primary_purpose",
      "input",
      "output",
      "genome_build_compatibility",
      "technical_compatibility",
      "maintenance_status",
      "selection_rationale",
      "appropriate_use",
      "interpretation_boundary",
      "key_limitations",
      "complementary_resources",
      "complementary_context",
      "official_url",
      "supporting_citation",
      "version_or_release",
      "reverify_at_use",
      "access_date",
      "status"
    ],
    "properties": {
      "resource_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable lowercase kebab-case identifier."
      },
      "resource_name": {
        "type": "string",
        "minLength": 1
      },
      "resource_class": {
        "type": "string",
        "enum": [
          "tool",
          "database",
          "predictor",
          "ontology",
          "guideline",
          "curation resource",
          "reference"
        ]
      },
      "analytical_function": {
        "type": "string",
        "minLength": 1,
        "description": "Semicolon-separated analytical functions using the Table 1 names."
      },
      "workflow_stages": {
        "type": "string",
        "pattern": "^(?:[1-9]|1[01])(?:;(?:[1-9]|1[01]))*$"
      },
      "evidence_type": {
        "type": "string",
        "enum": [
          "Technical",
          "Reference/annotation",
          "Population",
          "Phenotypic",
          "Phenotypic/computational",
          "Clinical/curated",
          "Computational",
          "Computational/transcript-based",
          "Computational/AI",
          "Regulatory/functional",
          "Structural/functional",
          "Clinical/literature",
          "Integrated clinical evidence",
          "Clinical/reporting"
        ]
      },
      "primary_purpose": {"type": "string", "minLength": 1},
      "input": {"type": "string", "minLength": 1},
      "output": {"type": "string", "minLength": 1},
      "genome_build_compatibility": {
        "type": "string",
        "minLength": 1,
        "description": "Semicolon-separated tokens: GRCh37, GRCh38, build independent, protein or transcript mapping, build dependent."
      },
      "technical_compatibility": {"type": "string", "minLength": 1},
      "maintenance_status": {
        "type": "string",
        "enum": [
          "Active",
          "Active/verify current status",
          "Active/legacy use",
          "Active/subscription",
          "Active/subscription tiered",
          "Active/archival",
          "Context dependent"
        ]
      },
      "selection_rationale": {"type": "string", "minLength": 1},
      "appropriate_use": {"type": "string", "minLength": 1},
      "interpretation_boundary": {"type": "string", "minLength": 1},
      "key_limitations": {"type": "string", "minLength": 1},
      "complementary_resources": {
        "type": "string",
        "description": "Semicolon-separated resource_id values. Empty if none."
      },
      "complementary_context": {
        "type": "string",
        "description": "Non-catalogued context such as RNA evidence or laboratory SOPs. Empty if none."
      },
      "official_url": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      },
      "supporting_citation": {
        "type": "string",
        "minLength": 1,
        "description": "Supporting publication or official documentation cited for this resource in the manuscript."
      },
      "version_or_release": {
        "type": "string",
        "minLength": 1,
        "not": {"const": "To be confirmed at use"},
        "description": "Checked release, dated document, or the exact value not recorded."
      },
      "reverify_at_use": {
        "type": "string",
        "enum": ["yes", "no"]
      },
      "access_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "status": {
        "type": "string",
        "enum": [
          "core representative resource",
          "candidate",
          "retired",
          "out of scope"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {"version_or_release": {"const": "not recorded"}},
          "required": ["version_or_release"]
        },
        "then": {
          "properties": {"reverify_at_use": {"const": "yes"}}
        }
      }
    ]
  }
}
